# Copy this file to server/.env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Database
# USE_MEMORY_DB=true  → no MongoDB installation needed (data resets on restart)
# USE_MEMORY_DB=false → real MongoDB (set MONGO_URI below)
USE_MEMORY_DB=true
MONGO_URI=mongodb://localhost:27017/voice_translator

# Auth
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Translation (MyMemory - free)
MYMEMORY_EMAIL=your_email@example.com